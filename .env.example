# ---- runner (Azure VM) ----
DOMAIN=                  # public DNS name of the VM, e.g. pr-agent.eastus.cloudapp.azure.com
RUNNER_TOKEN=change-me   # same value as the Forge variable RUNNER_TOKEN
EVENTS_URL=              # Forge runner-events web trigger URL (forge webtrigger)
GITHUB_TOKEN=            # to clone the demo repo
FACTORY_API_KEY=
ARTIFACTS_DIR=/data/artifacts
SANDBOX_IDLE_TTL_MIN=30

# ---- Forge app: set these with `forge variables set [--encrypt] NAME value`, not in this file ----
# RUNNER_URL, RUNNER_TOKEN, GITHUB_TOKEN, GITHUB_WEBHOOK_SECRET
