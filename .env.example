# Runner .env (laptop or VM). Copy to .env and fill in. Never commit .env.
# The Forge app does NOT read this file; see docs/SETUP.md for its `forge variables`.

RUNNER_TOKEN=change-me   # shared secret; same value as the Forge variable RUNNER_TOKEN
EVENTS_URL=              # Forge runner-events web trigger URL (run `forge webtrigger` after install)
GITHUB_TOKEN=            # fine-grained PAT, read access to the demo repo (to clone base/head)
FACTORY_API_KEY=         # Factory Droid key for the planner
ARTIFACTS_DIR=/data/artifacts
SANDBOX_IDLE_TTL_MIN=30
DOMAIN=                  # VM only: public DNS name for Caddy, e.g. pr-agent.eastus.cloudapp.azure.com
