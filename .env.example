# Runner .env (laptop or VM). Copy to .env and fill in. Never commit .env.
# The Forge app does NOT read this file; see docs/SETUP.md for its `forge variables`.

RUNNER_TOKEN=change-me   # shared secret; same value as the Forge variable RUNNER_TOKEN (openssl rand -hex 24)
EVENTS_URL=              # Forge runner-events web trigger URL (run `forge webtrigger` after install)
GITHUB_TOKEN=            # fine-grained PAT, Contents: read on the demo repo (to fetch base/head)
FACTORY_API_KEY=         # Factory Droid key for the planner (without it: canned scenarios + ask templates)
PUBLIC_URL=              # public base URL of the runner, e.g. https://pr-agent-saksham-20261024.westus2.cloudapp.azure.com
SANDBOX_IDLE_TTL_MIN=30
DOMAIN=                  # only for the compose `caddy` profile

# Optional
# DROID_MODEL=           # model for `droid exec --model`
# SANDBOX_APP_SERVICE=app SANDBOX_APP_PORT=3000 SANDBOX_HEALTH_PATH=/healthz
# SANDBOX_CPUS=1 SANDBOX_MEMORY=768m SANDBOX_BUILD_TIMEOUT_SEC=300
# SANDBOX_CA_CERT=       # extra CA trusted inside sandbox builds (TLS-intercepting proxies only)
