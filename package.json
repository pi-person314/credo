{
  "name": "pr-agent",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "check:contracts": "node scripts/sync-contracts.mjs --check",
    "dev:runner": "pnpm --filter @pr-agent/runner dev",
    "dev:runner-mock": "pnpm --filter @pr-agent/runner-mock dev"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
